	<!--
		Lets Razorpay's Standard Checkout SDK detect which UPI apps are
		installed (canOpenURL) so it can show/launch them directly instead of
		falling back to a generic UPI flow. Schemes per Razorpay's UPI Intent
		doc: https://razorpay.com/docs/payments/payment-methods/upi/upi-intent/
	-->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tez</string>
		<string>phonepe</string>
		<string>paytmmp</string>
		<string>credpay</string>
		<string>mobikwik</string>
		<string>in.fampay.app</string>
		<string>bhim</string>
		<string>amazonpay</string>
		<string>navi</string>
		<string>kiwi</string>
		<string>payzapp</string>
		<string>jupiter</string>
		<string>omnicard</string>
		<string>icici</string>
		<string>popclubapp</string>
		<string>sbiyono</string>
		<string>myjio</string>
		<string>slice-upi</string>
		<string>bobupi</string>
		<string>shriramone</string>
		<string>indusmobile</string>
		<string>whatsapp</string>
		<string>kotakbank</string>
	</array>

	<!--
		AdMob App ID. This is currently Google's published TEST app id (see
		lib/config/ad_config.dart) so banner ads render sample "Test Ad"
		creatives during development.

		TODO: replace with the real AdMob iOS App ID from your own AdMob
		console before release. Shipping the test id to a real App Store
		build violates AdMob policy.
	-->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-3940256099942544~1458002511</string>

	<!--
		Required by Apple for ad networks to work with SKAdNetwork on iOS 14+.
		cstr6suwn9.skadnetwork is Google's own network id and is the minimum
		entry needed for AdMob itself to attribute installs.

		TODO before release: paste Google's FULL current SKAdNetworkItems
		list from https://developers.google.com/admob/ios/choosing-networks
		(or the AdMob iOS quick-start) here. That list covers the mediation
		networks AdMob may route through and changes over time. Only the
		single Google entry below is included now because this
		implementation could not verify today's exact full list.
	-->
	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>cstr6suwn9.skadnetwork</string>
		</dict>
	</array>

</dict>
</plist>
